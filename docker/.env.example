# คัดลอกเป็น .env แล้วแก้ค่า
# docker compose จะอ่านไฟล์นี้ในโฟลเดอร์ docker/

# --- AdGuard Home ---
AGH_USER=admin
AGH_PASSWORD=change-me-strong

# เปิดให้ LAN เข้าถึง (default = 127.0.0.1 เท่านั้น)
# DNS_BIND=0.0.0.0
# DNS_PORT=53
# AGH_BIND=0.0.0.0
# AGH_PORT=3001

# --- internal network (ถ้าชน subnet เดิม) ---
# DNS_SUBNET=172.30.99.0/24
# UNBOUND_IP=172.30.99.10

# --- webapp ---
# WEBAPP_BIND=0.0.0.0
# WEBAPP_UID=1000
# WEBAPP_GID=1000
